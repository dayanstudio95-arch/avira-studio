# Supabase (new backend — replaces Base44)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Legacy Base44 vars — kept only until the frontend is fully migrated off @base44/sdk
VITE_BASE44_APP_ID=
VITE_BASE44_APP_BASE_URL=
VITE_BASE44_FUNCTIONS_VERSION=

# Native integrations (replace the Make.com layer — set server-side only, never in VITE_ vars)
GREEN_API_INSTANCE_ID=
GREEN_API_TOKEN=
MORNING_API_KEY=
MORNING_API_SECRET=

# Google Calendar OAuth (see DEPLOYMENT.md for the Google Cloud Console setup guide).
# One shared OAuth client for the whole platform — every tenant connects their own
# Google account(s) through it, tokens are stored per-tenant in google_calendar_accounts.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Random secret used to HMAC-sign the OAuth "state" param (generate with e.g. `openssl rand -hex 32`)
GOOGLE_OAUTH_STATE_SECRET=
# The deployed frontend origin, e.g. https://avira-studio.vercel.app — the OAuth
# callback redirects the browser back here after connecting an account.
APP_BASE_URL=
# Shared secret the periodic reconciliation cron job sends as the x-cron-secret
# header (same convention as AUTOMATION_ENGINE_CRON_SECRET).
CALENDAR_RECONCILE_CRON_SECRET=

# Notifications (see DEPLOYMENT.md section 8). Shared secret the
# leads.signed_at DB trigger sends as the x-cron-secret header when calling
# contract-signed-webhook (same convention as CALENDAR_RECONCILE_CRON_SECRET).
CONTRACT_NOTIFICATION_CRON_SECRET=
