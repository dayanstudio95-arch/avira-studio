{
  "name": "PendingAutomation",
  "type": "object",
  "properties": {
    "automationType": {
      "type": "string",
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d0\u05d5\u05d8\u05d5\u05de\u05e6\u05d9\u05d4"
    },
    "automationName": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05d0\u05d5\u05d8\u05d5\u05de\u05e6\u05d9\u05d4"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05d0\u05d9\u05e9\u05d5\u05e8"
    },
    "messages": {
      "type": "array",
      "description": "\u05de\u05e2\u05e8\u05da \u05d4\u05d4\u05d5\u05d3\u05e2\u05d5\u05ea \u05d4\u05de\u05de\u05ea\u05d9\u05e0\u05d5\u05ea \u05dc\u05d0\u05d9\u05e9\u05d5\u05e8",
      "items": {
        "type": "object"
      }
    },
    "totalCount": {
      "type": "number",
      "description": "\u05e1\u05da \u05d4\u05db\u05dc \u05d4\u05d5\u05d3\u05e2\u05d5\u05ea"
    },
    "approvedAt": {
      "type": "string",
      "format": "date-time",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d5\u05e9\u05e2\u05ea \u05d0\u05d9\u05e9\u05d5\u05e8"
    },
    "notes": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea"
    }
  },
  "required": [
    "automationType",
    "automationName",
    "messages",
    "totalCount"
  ]
}