    },
    "lastInvoiceUrl": {
      "type": "string",
      "description": "\u05dc\u05d9\u05e0\u05e7 \u05dc\u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05ea \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4 \u05e9\u05d4\u05d5\u05e4\u05e7\u05d4"
    },
    "depositInvoiceIssued": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05d5\u05e4\u05e7\u05d4 \u05d7\u05e9\u05d1\u05d5\u05e0\u05d9\u05ea \u05de\u05e7\u05d3\u05de\u05d4"
    },
