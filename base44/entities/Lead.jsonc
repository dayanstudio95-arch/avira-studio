    "linked_event_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2 \u05d4\u05de\u05e7\u05d5\u05e9\u05e8 \u05d1\u05d8\u05d1\u05dc\u05ea Event \u2014 \u05de\u05e7\u05d5\u05e8 \u05d4\u05d0\u05de\u05ea \u05dc\u05de\u05e0\u05d9\u05e2\u05ea \u05db\u05e4\u05d9\u05dc\u05d5\u05d9\u05d5\u05ea"
