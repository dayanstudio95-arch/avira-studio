    "discount": {
      "type": "number",
      "default": 0,
      "description": "\u05d4\u05e0\u05d7\u05d4 (\u20aa)"
    },
    "finalPrice": {
      "type": "number",
      "description": "\u05e1\u05db\u05d5\u05dd \u05e1\u05d5\u05e4\u05d9 (\u20aa)"
    },
