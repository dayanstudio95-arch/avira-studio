      "description": "\u05de\u05e1\u05e4\u05e8 \u05d9\u05d9\u05d7\u05d5\u05d3\u05d9 \u05e8\u05e5 \u05e9\u05dc \u05d4\u05e1\u05d8\u05d5\u05d3\u05d9\u05d5 (Auto-increment)"
    },
    "coupleNames": {
      "type": "string",
      "description": "\u05e9\u05de\u05d5\u05ea \u05d4\u05d6\u05d5\u05d2"
    },
    "eventDate": {
      "type": "string",
      "format": "date",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d4\u05d0\u05d9\u05e8\u05d5\u05e2"
    },
    "phoneNumber": {
      "type": "string",
      "description": "\u05d8\u05dc\u05e4\u05d5\u05df"
    },
    "email": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc"
    },
    "idNumber": {
      "type": "string",
      "description": "\u05ea\u05e2\u05d5\u05d3\u05ea \u05d6\u05d4\u05d5\u05ea"
    },
    "coupleNotesSigned": {
      "type": "string",
      "description": "\u05d4\u05e2\u05e8\u05d5\u05ea \u05d4\u05d6\u05d5\u05d2 \u05de\u05d4\u05d7\u05ea\u05d9\u05de\u05d4"
    },
    "signedCoupleNames": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05d6\u05d5\u05d2 \u05db\u05e4\u05d9 \u05e9\u05d4\u05d5\u05d6\u05df \u05d1\u05d7\u05ea\u05d9\u05de\u05d4 \u05e2\u05dc \u05d4\u05d7\u05d5\u05d6\u05d4"
    },
    "signedPhoneNumber": {
      "type": "string",
      "description": "\u05d8\u05dc\u05e4\u05d5\u05df \u05db\u05e4\u05d9 \u05e9\u05d4\u05d5\u05d6\u05df \u05d1\u05d7\u05ea\u05d9\u05de\u05d4 \u05e2\u05dc \u05d4\u05d7\u05d5\u05d6\u05d4"
    },
    "signedEmail": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d9\u05d9\u05dc \u05db\u05e4\u05d9 \u05e9\u05d4\u05d5\u05d6\u05df \u05d1\u05d7\u05ea\u05d9\u05de\u05d4 \u05e2\u05dc \u05d4\u05d7\u05d5\u05d6\u05d4"
    },
    "signedIdNumber": {
      "type": "string",
      "description": "\u05ea\u05e2\u05d5\u05d3\u05ea \u05d6\u05d4\u05d5\u05ea \u05db\u05e4\u05d9 \u05e9\u05d4\u05d5\u05d6\u05e0\u05d4 \u05d1\u05d7\u05ea\u05d9\u05de\u05d4 \u05e2\u05dc \u05d4\u05d7\u05d5\u05d6\u05d4"
    },
    "venueName": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05d0\u05d5\u05dc\u05dd"
    },
    "packageChoice": {
      "type": "string",
      "enum": [
        "\u05d7\u05d1\u05d9\u05dc\u05d4 1",
        "\u05d7\u05d1\u05d9\u05dc\u05d4 2",
        "\u05d7\u05d1\u05d9\u05dc\u05d4 3",
        "\u05d7\u05d1\u05d9\u05dc\u05d4 4"
      ],
      "description": "\u05d1\u05d7\u05d9\u05e8\u05ea \u05d7\u05d1\u05d9\u05dc\u05d4"
    },
    "packageId": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d7\u05d1\u05d9\u05dc\u05d4 \u05d4\u05e0\u05d1\u05d7\u05e8\u05ea"
