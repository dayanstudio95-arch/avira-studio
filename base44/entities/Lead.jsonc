      "type": "number",
      "default": 3,
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d0\u05e0\u05e9\u05d9 \u05d4\u05e6\u05d5\u05d5\u05ea \u05d4\u05e0\u05d3\u05e8\u05e9\u05d9\u05dd"
    },
    "status": {
      "type": "string",
      "enum": [
