{
  "name": "EventAutomation",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05d0\u05d5\u05d8\u05d5\u05de\u05e6\u05d9\u05d4"
    },
    "isActive": {
      "type": "boolean",
      "default": false,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05d0\u05d5\u05d8\u05d5\u05de\u05e6\u05d9\u05d4 \u05e4\u05e2\u05d9\u05dc\u05d4"
    },
    "triggerType": {
      "type": "string",
      "enum": [
        "days_after_proposal",
        "days_after_event",
        "status_based"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d8\u05e8\u05d9\u05d2\u05e8"
    },
    "triggerDays": {
      "type": "number",
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d4\u05d9\u05de\u05d9\u05dd \u05d0\u05d7\u05e8\u05d9 \u05d0\u05d9\u05e8\u05d5\u05e2 \u05d0\u05d5 \u05d4\u05e6\u05e2\u05d4"
    },
    "triggerStatus": {
      "type": "string",
      "enum": [
        "proposal_sent",
        "event_completed",
        "album_pending"
      ],
      "description": "\u05d4\u05e1\u05d8\u05d8\u05d5\u05e1 \u05e9\u05d8\u05e8\u05d9\u05d2\u05e8\u05d9\u05dd \u05d0\u05ea \u05d4\u05d0\u05d5\u05d8\u05d5\u05de\u05e6\u05d9\u05d4"
    },
    "triggerDescription": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05d1\u05e2\u05d1\u05e8\u05d9\u05ea \u05e9\u05dc \u05d4\u05d8\u05e8\u05d9\u05d2\u05e8"
    },
    "messageTemplate": {
      "type": "string",
      "description": "\u05ea\u05d1\u05e0\u05d9\u05ea \u05d4\u05d4\u05d5\u05d3\u05e2\u05d4 \u05d1\u05d5\u05d5\u05d0\u05d8\u05e1\u05d0\u05e4 (Rich Text)"
    },
    "variables": {
      "type": "array",
      "description": "\u05e8\u05e9\u05d9\u05de\u05ea \u05d4\u05ea\u05d2\u05d9\u05d5\u05ea \u05d4\u05d6\u05de\u05d9\u05e0\u05d5\u05ea \u05d1\u05ea\u05d1\u05e0\u05d9\u05ea",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string"
          },
          "label": {
            "type": "string"
          }
        }
      }
    },
    "lastExecuted": {
      "type": "string",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d5\u05e9\u05e2\u05ea \u05d1\u05d9\u05e6\u05d5\u05e2 \u05d0\u05d7\u05e8\u05d5\u05df"
    },
    "targetCount": {
      "type": "number",
      "default": 0,
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d4\u05dc\u05e7\u05d5\u05d7\u05d5\u05ea \u05e9\u05e2\u05d5\u05de\u05d3\u05d9\u05dd \u05d1\u05ea\u05e0\u05d0\u05d9 \u05d4\u05d0\u05d5\u05d8\u05d5\u05de\u05e6\u05d9\u05d4"
    }
  },
  "required": [
    "name",
    "triggerType",
    "messageTemplate"
  ]
}