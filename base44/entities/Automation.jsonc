{
  "name": "Automation",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05d0\u05d5\u05d8\u05d5\u05de\u05e6\u05d9\u05d4"
    },
    "type": {
      "type": "string",
      "enum": [
        "monthly_staff_summary",
        "daily_event_brief",
        "questionnaire_reminder",
        "album_reminder",
        "payment_reminder",
        "questionnaire_send",
        "custom"
      ],
      "description": "\u05e1\u05d5\u05d2 \u05d4\u05d0\u05d5\u05d8\u05d5\u05de\u05e6\u05d9\u05d4"
    },
    "emoji": {
      "type": "string",
      "description": "\u05d0\u05d9\u05de\u05d5\u05d2'\u05d9 \u05dc\u05d6\u05d9\u05d4\u05d5\u05d9 \u05d5\u05d5\u05d9\u05d6\u05d5\u05d0\u05dc\u05d9"
    },
    "isActive": {
      "type": "boolean",
      "default": true,
      "description": "\u05d4\u05d0\u05dd \u05d4\u05d0\u05d5\u05d8\u05d5\u05de\u05e6\u05d9\u05d4 \u05e4\u05e2\u05d9\u05dc\u05d4"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "monthly_1st",
        "daily",
        "manual"
      ],
      "description": "\u05ea\u05d3\u05e8 \u05d4\u05e4\u05e2\u05dc\u05d4"
    },
    "run_day": {
      "type": "number",
      "default": 1,
      "description": "\u05d9\u05d5\u05dd \u05d1\u05d7\u05d5\u05d3\u05e9 \u05dc\u05d4\u05e8\u05e6\u05d4 (1-31)"
    },
    "run_time": {
      "type": "string",
      "default": "09:00",
      "description": "\u05e9\u05e2\u05ea \u05d4\u05e8\u05e6\u05d4 HH:MM"
    },
    "target_month_mode": {
      "type": "string",
      "enum": [
        "next_month",
        "current_month"
      ],
      "default": "next_month",
      "description": "\u05d7\u05d5\u05d3\u05e9 \u05d4\u05d9\u05e2\u05d3 - \u05d4\u05d1\u05d0 \u05d0\u05d5 \u05d4\u05e0\u05d5\u05db\u05d7\u05d9"
    },
    "channel": {
      "type": "string",
      "enum": [
        "whatsapp",
        "email"
      ],
      "default": "whatsapp",
      "description": "\u05e2\u05e8\u05d5\u05e5 \u05e9\u05dc\u05d9\u05d7\u05d4"
    },
    "messageTemplate": {
      "type": "string",
      "description": "\u05ea\u05d1\u05e0\u05d9\u05ea \u05d4\u05d5\u05d3\u05e2\u05d4 \u05e2\u05dd \u05de\u05e9\u05ea\u05e0\u05d9\u05dd \u05d3\u05d9\u05e0\u05de\u05d9\u05d9\u05dd"
    },
    "filterLogic": {
      "type": "string",
      "description": "\u05ea\u05d9\u05d0\u05d5\u05e8 \u05dc\u05d5\u05d2\u05d9\u05e7\u05ea \u05e4\u05d9\u05dc\u05d8\u05d5\u05e8"
    },
    "mediaFileUrl": {
      "type": "string",
      "description": "URL \u05e7\u05d5\u05d1\u05e5 \u05de\u05d3\u05d9\u05d4 \u05dc\u05e9\u05dc\u05d9\u05d7\u05d4"
    },
    "test_mode": {
      "type": "boolean",
      "default": false,
      "description": "\u05de\u05e6\u05d1 \u05d1\u05d3\u05d9\u05e7\u05d4 \u2014 \u05e9\u05d5\u05dc\u05d7 \u05e8\u05e7 \u05dc-test_phone"
    },
    "test_phone": {
      "type": "string",
      "description": "\u05d8\u05dc\u05e4\u05d5\u05df \u05dc\u05d1\u05d3\u05d9\u05e7\u05d4 \u05d1\u05de\u05e6\u05d1 test_mode"
    },
    "last_run_at": {
      "type": "string",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d5\u05e9\u05e2\u05ea \u05e8\u05d9\u05e6\u05d4 \u05d0\u05d7\u05e8\u05d5\u05e0\u05d4"
    },
    "next_run_at": {
      "type": "string",
      "description": "\u05ea\u05d0\u05e8\u05d9\u05da \u05d5\u05e9\u05e2\u05ea \u05e8\u05d9\u05e6\u05d4 \u05d4\u05d1\u05d0\u05d4"
    },
    "lastRunResults": {
      "type": "string",
      "description": "\u05ea\u05d5\u05e6\u05d0\u05d5\u05ea \u05e8\u05d9\u05e6\u05d4 \u05d0\u05d7\u05e8\u05d5\u05e0\u05d4 (JSON)"
    },
    "selectedStaffIds": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "\u05e8\u05e9\u05d9\u05de\u05ea \u05de\u05d6\u05d4\u05d9 \u05d0\u05e0\u05e9\u05d9 \u05e6\u05d5\u05d5\u05ea \u05e9\u05d9\u05e7\u05d1\u05dc\u05d5 \u05d4\u05d5\u05d3\u05e2\u05d4"
    },
    "months_ahead": {
      "type": "number",
      "default": 1,
      "description": "\u05de\u05e1\u05e4\u05e8 \u05d7\u05d5\u05d3\u05e9\u05d9\u05dd \u05e7\u05d3\u05d9\u05de\u05d4 (\u05dc\u05e9\u05dc\u05d9\u05d7\u05ea \u05e9\u05d0\u05dc\u05d5\u05df)"
    }
  },
  "required": [
    "name",
    "type",
    "frequency",
    "messageTemplate"
  ]
}