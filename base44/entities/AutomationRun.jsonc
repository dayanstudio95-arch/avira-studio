{
  "name": "AutomationRun",
  "type": "object",
  "properties": {
    "automation_id": {
      "type": "string",
      "description": "\u05de\u05d6\u05d4\u05d4 \u05d4\u05d0\u05d5\u05d8\u05d5\u05de\u05e6\u05d9\u05d4"
    },
    "automation_name": {
      "type": "string",
      "description": "\u05e9\u05dd \u05d4\u05d0\u05d5\u05d8\u05d5\u05de\u05e6\u05d9\u05d4 (snapshot)"
    },
    "started_at": {
      "type": "string",
      "description": "\u05d6\u05de\u05df \u05d4\u05ea\u05d7\u05dc\u05ea \u05e8\u05d9\u05e6\u05d4"
    },
    "completed_at": {
      "type": "string",
      "description": "\u05d6\u05de\u05df \u05e1\u05d9\u05d5\u05dd \u05e8\u05d9\u05e6\u05d4"
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "completed",
        "error"
      ],
      "default": "running",
      "description": "\u05e1\u05d8\u05d8\u05d5\u05e1 \u05d4\u05e8\u05d9\u05e6\u05d4"
    },
    "messages_sent": {
      "type": "number",
      "default": 0,
      "description": "\u05db\u05de\u05d4 \u05d4\u05d5\u05d3\u05e2\u05d5\u05ea \u05e0\u05e9\u05dc\u05d7\u05d5"
    },
    "messages_failed": {
      "type": "number",
      "default": 0,
      "description": "\u05db\u05de\u05d4 \u05d4\u05d5\u05d3\u05e2\u05d5\u05ea \u05e0\u05db\u05e9\u05dc\u05d5"
    },
    "error_message": {
      "type": "string",
      "description": "\u05d4\u05d5\u05d3\u05e2\u05ea \u05e9\u05d2\u05d9\u05d0\u05d4 \u05d0\u05dd \u05e0\u05db\u05e9\u05dc"
    },
    "triggered_by": {
      "type": "string",
      "enum": [
        "scheduler",
        "manual"
      ],
      "default": "scheduler",
      "description": "\u05de\u05d9 \u05d4\u05e4\u05e2\u05d9\u05dc \u05d0\u05ea \u05d4\u05e8\u05d9\u05e6\u05d4"
    }
  },
  "required": [
    "automation_id",
    "automation_name",
    "status"
  ]
}